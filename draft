import numpy as np

def idw(distances, values, power=2):
    weights = 1 / (distances ** power)
    weights /= weights.sum()
    return np.sum(weights * values)

# Example: interpolate for one unknown point
dists = np.array([10.0, 25.0, 40.0])   # km to stations
vals  = np.array([1200, 1500, 900])    # rainfall
estimate = idw(dists, vals)
print(estimate)



